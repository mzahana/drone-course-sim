<?xml version="1.0" ?>
<!--
  The ground target the drone follows.

  Derived from the Gazebo Fuel "Pickup" model. Changes from the original:

    * no longer <static>: the course needs it to drive a route;
    * a box collision instead of the full mesh, because colliding a detailed
      vehicle mesh against the ground every step is expensive and buys nothing
      for a target that only has to look like a truck to a camera;
    * a VelocityControl plugin, so a route driver can command it over cmd_vel;
    * an OdometryPublisher, which is the scoring script's ground truth.

  It has to be recognisable to YOLO as a vehicle, which is exactly why a
  textured mesh is used rather than a box primitive: COCO has no "box" class.
-->
<sdf version="1.9">
  <model name="course_target_vehicle">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>1500</mass>
        <inertia>
          <ixx>800</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>3000</iyy><iyz>0</iyz>
          <izz>3400</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0.93 0 0 0</pose>
        <geometry>
          <box><size>5.66 2.47 1.86</size></box>
        </geometry>
      </collision>

      <!-- The mesh is modelled with the vehicle's LENGTH along its own +Y and
           its nose toward +Y, in inches. Dropped in unrotated, the truck sits
           broadside to the direction VelocityControl drives it: linear.x is the
           model's +X, so the target drove sideways across the world, its
           heading permanently 90 degrees from its velocity.

           That is not a cosmetic problem. The whole guidance law is built on
           the target's direction of travel, and a target whose body points one
           way while it moves another makes the standoff reference and anything
           a student infers from the image disagree by a right angle.

           Rotating by -90 degrees about Z puts the nose on +X, where the
           collision box, the drive direction and the picture finally agree.
           Measured mesh extents (converted from inches): 2.47 wide, 5.66 long,
           1.86 tall, bottom on the ground. -->
      <visual name="visual">
        <pose>0 0 0 0 0 -1.5707963267949</pose>
        <geometry>
          <mesh><uri>meshes/pickup.dae</uri></mesh>
        </geometry>
      </visual>
    </link>

    <!-- Driven by the route driver over /model/course_target_vehicle/cmd_vel. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
    </plugin>

    <!-- Ground truth for scoring. Never for flight. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>course_world</odom_frame>
      <robot_base_frame>course_target_vehicle</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
