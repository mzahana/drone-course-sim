<?xml version="1.0"?>
<model>
  <name>course_target_vehicle</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Nate Koenig</name>
    <email>nate@osrfoundation.org</email>
  </author>
  <description>
    The ground target the course drone follows. Mesh and textures are the
    "Pickup" model from Gazebo Fuel (Open Robotics / Nate Koenig); the body has
    been made dynamic and given a velocity-controlled drive so it can be driven
    along a route. See ../README.md for attribution.
  </description>
</model>
