<?xml version="1.0"?>
<model>
  <name>course_ground</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Textured ground for the course world. Replaces the stock untextured grey
    plane, which gave no visual motion cue and made every screenshot a grey
    void. Geometry is identical: a flat plane at z equals 0.
  </description>
</model>
