<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="course_ground">
    <static>true</static>
    <link name="link">

      <!-- Collision stays an infinite plane. The visual is a finite mesh, so
           anything that leaves the 500 m square still lands on something
           solid rather than falling forever. -->
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1 1</size>
          </plane>
        </geometry>
        <surface>
          <friction><ode/></friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>

      <!-- A mesh, not a plane. A plane visual stretches one texture over the
           whole 500 m, which is a quarter of a metre per pixel: mush from any
           altitude the course flies at. The mesh carries UVs that repeat the
           texture once every 5 m, so the resolution on screen is set by the
           tile and not by the size of the field. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://course_ground/meshes/ground.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://course_ground/materials/textures/grass.jpg</albedo_map>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>

    </link>
  </model>
</sdf>
