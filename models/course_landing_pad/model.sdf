<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="course_landing_pad">
    <static>true</static>
    <link name="link">
      <!-- No <collision>, deliberately: see make_pad.py. The aircraft stands
           on course_ground exactly as before; this is paint, 3 mm proud of
           the grass so it never z-fights with it. -->
      <visual name="visual">
        <pose>0 0 0.003 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://course_landing_pad/meshes/pad.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://course_landing_pad/materials/textures/pad.png</albedo_map>
              <roughness>0.85</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
