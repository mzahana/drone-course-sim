#!/usr/bin/env bash
# The course helper. One command per thing a student needs to do.
set -uo pipefail

# Source ROS ourselves. `docker exec bash -c` reads no init file at all, and
# Ubuntu's .bashrc returns early for non-interactive shells -- so relying on an
# init file means `course sim` works in your terminal and fails in a script.
if [ -z "${AMENT_PREFIX_PATH:-}" ]; then
    # ROS's setup.bash reads unbound variables, so `set -u` must be off for it.
    set +u
    source "/opt/ros/${ROS_DISTRO:-jazzy}/setup.bash"
    set -u
fi
export PX4_DIR="${PX4_DIR:-/opt/PX4-Autopilot}"
export GZ_SIM_RESOURCE_PATH="${PX4_DIR}/Tools/simulation/gz/models:${PX4_DIR}/Tools/simulation/gz/worlds:${GZ_SIM_RESOURCE_PATH:-}"

RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'; RST=$'\e[0m'
ok()   { echo "  ${GRN}ok${RST}    $1"; }
bad()  { echo "  ${RED}FAIL${RST}  $1"; FAILED=1; }
warn() { echo "  ${YEL}warn${RST}  $1"; }

PX4_DIR="${PX4_DIR:-/opt/PX4-Autopilot}"
WS="$HOME/shared_volume/ros2_ws"

doctor() {
    FAILED=0
    echo "Drone course environment check"
    echo
    echo "ROS 2"
    [ -n "${ROS_DISTRO:-}" ] && ok "ROS_DISTRO=$ROS_DISTRO" || bad "ROS not sourced"
    command -v ros2 >/dev/null && ok "ros2 CLI" || bad "ros2 CLI missing"
    ros2 pkg prefix mavros >/dev/null 2>&1 && ok "mavros installed" || bad "mavros missing"
    ros2 pkg prefix ros_gz_bridge >/dev/null 2>&1 && ok "ros_gz_bridge installed" || bad "ros_gz_bridge missing"

    echo
    echo "Gazebo"
    if command -v gz >/dev/null; then ok "gz $(gz sim --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"
    else bad "gz not on PATH"; fi
    [ -d "$PX4_DIR/Tools/simulation/gz/models" ] && ok "PX4 gz models present" || bad "PX4 gz models missing"

    echo
    echo "PX4"
    if [ -x "$PX4_DIR/build/px4_sitl_default/bin/px4" ]; then
        ok "px4 binary built ($(cat "$PX4_DIR/PX4_COURSE_VERSION" 2>/dev/null || echo unknown))"
    else bad "px4 binary not built"; fi
    [ -f "$PX4_DIR/ROMFS/px4fmu_common/init.d-posix/airframes/4090_gz_x500_course_gimbal" ] \
        && ok "course gimbal airframe available" || bad "course gimbal airframe missing"
    for m in course_x500_base course_x500 course_gimbal x500_course_gimbal course_target_vehicle course_landing_pad; do
        [ -d "$PX4_DIR/Tools/simulation/gz/models/$m" ] \
            && ok "model $m installed" || bad "model $m missing"
    done
    [ -f "$PX4_DIR/Tools/simulation/gz/worlds/course_world.sdf" ] \
        && ok "course world installed" || bad "course world missing"

    echo
    echo "Geoid data (MAVROS will not start without it)"
    [ -d /usr/share/GeographicLib/geoids ] && ok "GeographicLib geoids" || bad "GeographicLib geoids missing"

    echo
    echo "Perception"
    python3 -c "import ultralytics" 2>/dev/null && ok "ultralytics" || bad "ultralytics missing"
    [ -f "${YOLO_WEIGHTS:-/opt/models/yolo11n.pt}" ] && ok "yolo11n weights baked in" || bad "yolo11n weights missing"
    # Three ways to be on the CPU, and only the first one is the student's
    # machine. The other two are a container that does not match the host.
    local torch_v
    torch_v="$(python3 -c "import torch; print(torch.__version__)" 2>/dev/null || echo unknown)"
    case "$torch_v" in
        *+cu*)   ok "torch $torch_v (CUDA build)" ;;
        unknown) bad "torch not importable" ;;
        *)       ok "torch $torch_v (CPU build)" ;;
    esac
    if python3 -c "import torch,sys; sys.exit(0 if torch.cuda.is_available() else 1)" 2>/dev/null; then
        ok "CUDA available ($(python3 -c 'import torch; print(torch.cuda.get_device_name(0))' 2>/dev/null))"
    elif [ "${COURSE_TORCH:-cpu}" != "cpu" ]; then
        warn "this is the GPU image, but no GPU reached the container. On the host:"
        warn "  ./run.sh --fresh   (needs the NVIDIA Container Toolkit; see docs/prework.md)"
    elif [ -e /dev/nvidiactl ]; then
        warn "GPU present, but this is the CPU image — YOLO runs on CPU (fine)."
        warn "  For GPU inference, on the host: ./build.sh, then ./run.sh --fresh"
    else warn "no CUDA — inference will run on CPU (fine, just slower)"; fi
    gpu_render_env
    # A render node the user cannot open means BLACK windows on a Wayland
    # desktop, not an error message. run.sh adds the group; an older container
    # does not have it.
    local node
    for node in /dev/dri/renderD*; do
        [ -e "$node" ] || continue
        if [ -r "$node" ] && [ -w "$node" ]; then ok "GPU render node $node accessible"
        else warn "cannot open $node — GUI windows may stay black. On the host: ./run.sh --fresh"; fi
        break
    done
    if [ -n "${GPU_RENDER}" ]; then ok "GPU rendering for Gazebo: ${GPU_RENDER}"
    else warn "no GPU for rendering — Gazebo runs in software and may not reach real time"; fi

    echo
    echo "Ground station"
    [ -x /opt/qgroundcontrol/AppRun ] \
        && ok "QGroundControl $(cat /opt/qgroundcontrol/QGC_COURSE_VERSION 2>/dev/null)" \
        || bad "QGroundControl missing"
    command -v websockify >/dev/null && ok "web desktop available (course desktop)" \
        || warn "no websockify -- the browser desktop fallback will not start"

    echo
    echo "Exercises"
    for l in lab3_offboard lab4_perception lab5_follow capstone_follow; do
        [ -d "${EXERCISES:-/opt/course_exercises}/skeletons/$l" ] \
            && ok "skeleton $l" || bad "skeleton $l missing"
    done

    echo
    echo "Graphics"
    [ -n "${DISPLAY:-}" ] && ok "DISPLAY=$DISPLAY" || warn "no DISPLAY — GUI tools will not open"

    echo
    echo "Your workspace"
    # The shared volume is a bind mount and keeps the host's numeric owner.
    # If that does not match the user in here, everything looks fine until the
    # first colcon build dies on a permission error with no obvious cause.
    if [ ! -d "$HOME/shared_volume" ]; then
        warn "no shared volume mounted — your work will not survive the container"
    elif ( set -e; t="$HOME/shared_volume/.write_check_$$"; touch "$t"; rm -f "$t" ) 2>/dev/null; then
        ok "shared volume is writable"
    else
        bad "shared volume is NOT writable by $(id -un) (uid $(id -u))"
        echo "        it is owned by uid $(stat -c %u "$HOME/shared_volume")."
        echo "        On the host: docker rm -f ${NAME:-drone-course} and re-run ./run.sh,"
        echo "        which aligns the uid for you."
    fi

    echo
    echo "Your workspace"
    [ -d "$WS/src" ] && ok "$WS/src" || warn "no workspace yet — run: course init"

    echo
    [ "$FAILED" -eq 0 ] && echo "${GRN}Environment looks good.${RST}" || echo "${RED}Something is wrong above.${RST}"
    return "$FAILED"
}

init() {
    if ! mkdir -p "$WS/src" 2>/dev/null; then
        echo "${RED}Cannot create $WS/src.${RST}  Run ${GRN}course doctor${RST}."
        return 1
    fi
    # mkdir -p on an existing directory succeeds even when it is read-only to
    # us, so "it worked" here would be a lie. Prove we can write.
    if ! ( t="$WS/src/.write_check_$$"; touch "$t" && rm -f "$t" ) 2>/dev/null; then
        echo "${RED}$WS/src exists but is not writable by you.${RST}"
        echo "Run ${GRN}course doctor${RST} — this is almost always a uid mismatch"
        echo "on the shared volume, and re-running ./run.sh on the host fixes it."
        return 1
    fi
    echo "Workspace ready at $WS/src"
    echo "On your host machine this is ~/drone_course_shared_volume/ros2_ws/src"
}

# Point OpenGL at the GPU that run.sh passed in, if any. Without this, on an
# NVIDIA machine EGL picks Mesa, fails ("failed to open /dev/dri/renderD128"),
# and Gazebo renders in software. While recording the course media that cost a
# real-time factor of 0.38 instead of 1.00, and a slow simulation is an EASIER
# one to follow a target in (spike note 38). An idle RTX 5090 desktop held 1.00
# either way (spike note 45); a laptop CPU will not. Set here, for the simulator
# only, rather than container-wide: forcing the NVIDIA GLX vendor on every
# program is untested with RViz and QGroundControl on the browser desktop.
gpu_render_env() {
    if [ -e /dev/dxg ] && [ -d /usr/lib/wsl/lib ]; then
        # WSL2: Mesa's d3d12 driver, on top of the Windows GPU driver.
        export GALLIUM_DRIVER=d3d12
        GPU_RENDER="WSL2 d3d12${MESA_D3D12_DEFAULT_ADAPTER_NAME:+ (${MESA_D3D12_DEFAULT_ADAPTER_NAME})}"
    elif [ -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        GPU_RENDER="NVIDIA"
    else
        GPU_RENDER=""
    fi
}

sim() {
    gpu_render_env
    echo "Starting PX4 SITL with the course gimbal (partition: ${GZ_PARTITION:-unset})..."
    if [ -n "${GPU_RENDER}" ]; then echo "Rendering on the GPU: ${GPU_RENDER}"
    else echo "No GPU in this container: Gazebo renders in software (check the real-time factor)"; fi
    cd "$PX4_DIR" || exit 1
    make px4_sitl gz_x500_course_gimbal_course_world
}

# The web desktop. X11 forwarding works on Linux and on Windows with WSLg and
# is a support nightmare anywhere else; this is the fallback that means nobody
# is blocked on Day 1 by their laptop's graphics stack.
desktop() {
    local disp="${COURSE_DISPLAY:-:99}"
    local port="${COURSE_VNC_PORT:-6080}"
    if pgrep -f "Xvfb ${disp}" > /dev/null; then
        echo "web desktop already running on ${disp}"
    else
        Xvfb "${disp}" -screen 0 "${COURSE_RES:-1600x900x24}" > /tmp/xvfb.log 2>&1 &
        sleep 1
        DISPLAY="${disp}" openbox > /tmp/openbox.log 2>&1 &
        DISPLAY="${disp}" x11vnc -display "${disp}" -forever -shared -nopw \
            -quiet -rfbport 5900 > /tmp/x11vnc.log 2>&1 &
        sleep 1
        websockify --web=/usr/share/novnc "${port}" localhost:5900 \
            > /tmp/websockify.log 2>&1 &
        sleep 1
    fi
    # Every terminal opened after this picks the display up from here.
    echo "${disp}" > /tmp/.course_display
    export DISPLAY="${disp}"
    echo
    echo "  ${GRN}Open http://localhost:${port}/vnc.html in your browser.${RST}"
    echo "  Terminals you open from now on will use DISPLAY=${disp}."
    echo "  In THIS terminal, run:  export DISPLAY=${disp}"
    echo
}

qgc() {
    if [ -z "${DISPLAY:-}" ]; then
        echo "${RED}No DISPLAY.${RST} Run 'course desktop' first, or start the"
        echo "container with X11 forwarding."
        return 1
    fi
    echo "QGroundControl $(cat /opt/qgroundcontrol/QGC_COURSE_VERSION 2>/dev/null || echo '')"
    echo "It finds SITL by itself on UDP 14550. Give it a few seconds."
    qgroundcontrol "$@" &
}

# PX4 writes its logs inside its own build tree, which is not in the shared
# volume -- so a student cannot open one from the host, which is exactly what
# Lab 2 asks them to do. This copies the newest one somewhere they can reach.
logs() {
    local src="${PX4_DIR}/build/px4_sitl_default/rootfs/log"
    local dst="$HOME/shared_volume/logs"
    [ -d "$src" ] || { echo "${RED}no logs yet at $src${RST}"; return 1; }
    mkdir -p "$dst"
    local newest
    newest="$(find "$src" -name '*.ulg' -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
    [ -n "$newest" ] || { echo "${RED}no .ulg files under $src${RST}"; return 1; }
    cp "$newest" "$dst/"
    echo "${GRN}$(basename "$newest")${RST} -> $dst/"
    echo "On your host: ~/drone_course_shared_volume/logs/$(basename "$newest")"
    echo "Upload it to https://review.px4.io to analyse it."
}

mavros_up() {
    # node.launch, not px4.launch: px4.launch hardcodes its own config path, so
    # it would start MAVROS with different parameters than `course bringup`
    # does -- including use_sim_time. Same config, same behaviour, always.
    local share
    share="$(ros2 pkg prefix drone_course_sim)/share/drone_course_sim"
    ros2 launch mavros node.launch \
        fcu_url:="udp://:14540@127.0.0.1:14557" \
        gcs_url:="" tgt_system:=1 tgt_component:=1 \
        pluginlists_yaml:="${share}/config/mavros_pluginlists.yaml" \
        config_yaml:="${share}/config/mavros_px4.yaml" \
        "$@"
}

# Everything `course bringup` and a mission start. Used by `course stop`, and
# by bringup itself to refuse to start a second copy.
COURSE_PROCS=(
    "ros_gz_image/image_bridge"        # the camera bridge
    "ros_gz_bridge/parameter_bridge"
    "drone_course_sim/lib"             # detector, gimbal, TF, route, scoring
    "mavros_node"
    "mavros_router"
    "robot_state_publisher"
    "shared_volume/ros2_ws/install"    # the student's own nodes
)

course_running() {
    local p
    for p in "${COURSE_PROCS[@]}"; do
        pgrep -f "$p" > /dev/null && return 0
    done
    return 1
}

# `course stop` -- put the stack down, and leave nothing behind.
#
# This exists because leaving one process alive is the most expensive failure
# in this environment and the hardest to see. Ctrl-C on a `ros2 launch` kills
# the launch parent; the nodes it started keep running. Do that a few times
# and you have a dozen camera bridges all republishing the same Gazebo images
# onto /camera/image_raw, the detector drowning in duplicate frames, and a
# stack that fails in ways that look like your code.
stop() {
    local p c n=0
    for p in "${COURSE_PROCS[@]}"; do
        # pgrep -c prints 0 AND exits non-zero when nothing matches, so a
        # `|| echo 0` fallback appends a second zero and the arithmetic dies.
        c="$(pgrep -fc "$p" 2>/dev/null)" || true
        n=$(( n + ${c:-0} ))
        pkill -f "$p" 2>/dev/null
    done
    sleep 2
    for p in "${COURSE_PROCS[@]}"; do pkill -9 -f "$p" 2>/dev/null; done
    if [ "${1:-}" = "--all" ]; then
        pkill -9 -f "gz sim" 2>/dev/null
        pkill -9 -f "bin/px4" 2>/dev/null
        echo "stopped the simulator too"
    fi
    sleep 1
    if course_running; then
        echo "${YEL}something survived:${RST}"
        for p in "${COURSE_PROCS[@]}"; do pgrep -af "$p" | head -3; done
    else
        echo "stopped ${GRN}${n}${RST} process(es); nothing left running"
    fi
}

# `course bringup` / `course bringup 2` / `course bringup tier:=2`
#
# The tier chooses the ROUTE the target drives, and it is set here -- not in
# the capstone launch file, whose own tier:= argument only labels the scoring
# report. Accept a bare number so the two cannot drift apart by a typo.
bringup() {
    # Refuse to start a second stack. Two camera bridges is not twice as good;
    # it is two publishers on /camera/image_raw and a detector that sees each
    # frame twice, at half the rate it thinks.
    if course_running; then
        echo "${YEL}A bringup is already running.${RST}"
        echo "Run ${GRN}course stop${RST} first, or ${GRN}course stop --all${RST}"
        echo "to put the simulator down as well."
        return 1
    fi
    if [[ "${1:-}" =~ ^-?[0-3]$ ]]; then set -- "tier:=$1" "${@:2}"; fi
    ros2 launch drone_course_sim sim_bringup.launch.py "$@"
}

rviz_up() {
    if [ -z "${DISPLAY:-}" ]; then
        echo "${RED}No DISPLAY.${RST} Run 'course desktop' first."
        return 1
    fi
    local share
    share="$(ros2 pkg prefix drone_course_sim)/share/drone_course_sim"
    ros2 run rviz2 rviz2 -d "${share}/rviz/course.rviz" \
        --ros-args -p use_sim_time:=true
}

verify() {
    ros2 run drone_course_sim verify_camera_frame.py
}

scenario_test() {
    ros2 run drone_course_sim scenario_test.py
}

# `course score` / `course score 2` / `course score 2 240`
#
# rclpy refuses an integer for a parameter declared double -- `duration:=180`
# is an error and `duration:=180.0` is not, which is a silly thing for a
# student to lose five minutes to in the middle of a graded run. Take plain
# numbers and do the conversion here.
score() {
    local tier="" dur=""
    if [[ "${1:-}" =~ ^[0-3]$ ]]; then tier="$1"; shift; fi
    if [[ "${1:-}" =~ ^[0-9]+$ ]]; then dur="$1.0"; shift
    elif [[ "${1:-}" =~ ^[0-9]+\.[0-9]+$ ]]; then dur="$1"; shift; fi
    local args=(--ros-args -p use_sim_time:=true)
    [ -n "$tier" ] && args+=(-p "tier:=$tier")
    [ -n "$dur" ] && args+=(-p "duration:=$dur")
    ros2 run drone_course_sim scoring_node.py "${args[@]}" "$@"
}

EXERCISES="${EXERCISES:-/opt/course_exercises}"

# `course new lab4` copies the skeleton into the student's workspace. It never
# overwrites: a student who has spent an hour on a file must not lose it to a
# mistyped command.
new_exercise() {
    local name="${1:-}"
    case "$name" in
        lab3|3)          pkg=lab3_offboard ;;
        lab4|4)          pkg=lab4_perception ;;
        lab5|5)          pkg=lab5_follow ;;
        capstone|project) pkg=capstone_follow ;;
        *) echo "usage: course new {lab3|lab4|lab5|capstone}"; return 1 ;;
    esac
    local src="$EXERCISES/skeletons/$pkg"
    [ -d "$src" ] || { echo "${RED}no skeleton for $pkg at $src${RST}"; return 1; }
    mkdir -p "$WS/src"
    if [ -d "$WS/src/$pkg" ]; then
        echo "${YEL}$WS/src/$pkg already exists -- leaving it alone.${RST}"
        echo "Delete or rename it first if you really want a fresh copy."
        return 1
    fi
    cp -r "$src" "$WS/src/$pkg"
    echo "${GRN}$pkg${RST} is now at $WS/src/$pkg"
    echo "On your host: ~/drone_course_shared_volume/ros2_ws/src/$pkg"
    echo
    sed -n '1,12p' "$WS/src/$pkg/README.md" 2>/dev/null
    echo
    echo "Build it with:"
    echo "  cd $WS && colcon build --packages-select $pkg && source install/setup.bash"
}

# `course solution 4` reveals the reference. Separate package names, so a
# student can build and run both and diff the behaviour rather than the files.
solution() {
    local name="${1:-}"
    case "$name" in
        lab3|3)          pkg=lab3_offboard_solution ;;
        lab4|4)          pkg=lab4_perception_solution ;;
        lab5|5)          pkg=lab5_follow_solution ;;
        capstone|project) pkg=capstone_follow_solution ;;
        *) echo "usage: course solution {lab3|lab4|lab5|capstone}"; return 1 ;;
    esac
    local src="$EXERCISES/solutions/$pkg"
    [ -d "$src" ] || { echo "${RED}no solution for $pkg at $src${RST}"; return 1; }
    init >/dev/null || return 1
    rm -rf "$WS/src/$pkg"
    if ! cp -r "$src" "$WS/src/$pkg"; then
        echo "${RED}could not copy $pkg into $WS/src${RST} — run ${GRN}course doctor${RST}"
        return 1
    fi
    echo "${GRN}$pkg${RST} is now at $WS/src/$pkg"
    echo "It is a separate package, so your own version still builds and runs."
    echo "  cd $WS && colcon build --packages-select $pkg && source install/setup.bash"
}

case "${1:-help}" in
    doctor) doctor ;;
    bringup) shift; bringup "$@" ;;
    stop) shift; stop "$@" ;;
    verify) verify ;;
    test) scenario_test ;;
    score) shift; score "$@" ;;
    new) shift; new_exercise "$@" ;;
    solution) shift; solution "$@" ;;
    desktop) desktop ;;
    qgc) shift; qgc "$@" ;;
    log|logs) logs ;;
    rviz) rviz_up ;;
    init)   init ;;
    sim)    sim ;;
    mavros) shift; mavros_up "$@" ;;
    *) cat <<USAGE
usage: course <command>

  doctor    check that everything needed is installed and working
  init      create your ROS 2 workspace in the shared volume
  sim       start PX4 SITL + Gazebo with the course gimbal
  stop [--all]  stop everything bringup started; --all stops the simulator too
  bringup [T]  start MAVROS, the gz bridges, the TF tree and the target
            route; T = tier 0-3 (default 1), which picks the route
  verify    check the full map -> base_link -> camera_optical_frame chain
  test      end-to-end scenario check (camera, detector, target, blackout)
  score [T] [S]  grade a running mission against ground truth
            T = tier 0-3, S = seconds (default 120)
  new N     scaffold a lab skeleton into your workspace  (lab3|lab4|lab5|capstone)
  solution N  reveal the reference solution for a lab
  desktop   start the browser-based desktop (no X11 needed)
  qgc       start QGroundControl
  log       copy the newest PX4 flight log into your shared volume
  rviz      open RViz with the course layout (TF, camera, estimate, reference)
  mavros    start MAVROS against the running SITL
USAGE
    ;;
esac
