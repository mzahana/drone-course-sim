<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="course_world">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- PX4's stock field, deliberately unchanged.
         EKF2's yaw in this simulator settles about 5 to 6 degrees away from
         Gazebo truth. That was chased down properly before being accepted:
         measured at 5.0 degrees with this field, 6.2 with the field rotated to
         the declination PX4's own geo lookup returns, and 5.9 degrees with
         STOCK PX4, the stock x500 and the stock world, with no course assets
         involved at all. It is a property of PX4 v1.17 SITL, it varies a little
         from run to run, and it is not something the course introduced or can
         tune away from here.

         What it costs is worth knowing, because it is the largest single term
         in the geolocation error budget: a yaw error rotates the bearing ray
         about the vertical, so a target at ground range R lands about
         R * tan(5.5 deg) = 0.1 * R to one side. At 15 m that is 1.5 m, more
         than the gimbal, the pixel and everything else combined.

         Two consequences are wired into the course rather than hidden: the
         scoring thresholds are set so that the achievable accuracy earns full
         marks, and the Day 3 error budget names vehicle attitude as the
         dominant term. Which is also true on the real aircraft, where the
         compass is the weakest sensor on board. -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <!--
      The ground target the drone follows.

      Placed 15 m ahead of the spawn point on purpose: with the aircraft still
      on the ground and the gimbal neutral, the truck fills enough of the frame
      for the detector to find it. That makes "does perception work at all" a
      test anyone can run in thirty seconds, without flying.

      The route driver moves it from here; see drone_course_sim's
      target_route_node and its `tier` parameter.
    -->
    <include>
      <uri>model://course_target_vehicle</uri>
      <name>course_target_vehicle</name>
      <!-- Yaw 90 degrees: broadside to the aircraft, and driving across its
           nose rather than at it.

           Two things had to be true at once. Facing the aircraft, the target
           drove straight through the spawn point and shoved the drone 13 m
           across the field before it could take off, after which the aircraft
           was too far behind to ever acquire it and tiers 2 and 3 scored as if
           the follower had failed. Facing away fixed that and broke something
           else: from the ground the drone then sees only the truck's rear, a
           dark open bed at a grazing angle, and the detector finds nothing at
           all. `course test` caught it, which is what that check is for.

           Broadside satisfies both. It is also the easiest aspect for the
           detector, which is what the thirty-second "does perception work"
           check wants, and the target drives along +y, clear of the drone. -->
      <pose>15 0 0 0 0 1.5707963267949</pose>
    </include>

  </world>
</sdf>
